# ==============================================================================
# TEMPLATE KONFIGURASI ENVIRONMENT — BOT ISTIMEWA v3.0 (.env.example)
# ==============================================================================

# ==========================================
# 1. KONFIGURASI SERVER & GO FIBER
# ==========================================
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=3000
API_SECRET_KEY=ganti_dengan_random_string_minimal_32_karakter

# ==========================================
# 2. IDENTITAS & SESI WHATSAPP
# ==========================================
WA_DEVICE_NAME="BPS KABUPATEN BANGKA BARAT"
WA_DB_PATH=./storage/whatsmeow.db
# Kosongkan ALLOWED_NUMBERS untuk mode publik. Isi (pisahkan koma) untuk mode testing.
ALLOWED_NUMBERS=

# ==========================================
# 3. KEAMANAN ADMIN CHAT
# ==========================================
ADMIN_TRIGGER_KEYWORD="login admin - 1903"
ADMIN_PASSWORD=ganti_dengan_password_admin_yang_kuat
# Hanya nomor di bawah ini yang bisa login admin di chat WA (format 628xxx, pisahkan koma)
ADMIN_WHITELIST_NUMBERS=6281234567890
ADMIN_MAX_RETRY=3
ADMIN_LOCKOUT_MINUTES=60
# Nomor WhatsApp pengembang untuk menu Hubungi Developer (format 628xxx)
DEVELOPER_PHONE=

# ==========================================
# 4. RATE LIMITER, IDLE TIMER & QUEUE
# ==========================================
USER_RATE_LIMIT_PER_10S=5
USER_COOLDOWN_SECONDS=60
IDLE_TIMEOUT_MINUTES=30
ACTIVE_INDICATOR_YEAR=2025
QUEUE_INTERACTIVE_MIN_DELAY_MS=600
QUEUE_INTERACTIVE_MAX_DELAY_MS=1200
QUEUE_BLAST_MIN_DELAY_MS=5000
QUEUE_BLAST_MAX_DELAY_MS=10000

# ==========================================
# 5. ENDPOINT GOOGLE APPS SCRIPT & CACHE
# ==========================================
GAS_CACHE_TTL_MINUTES=15
HTTP_CLIENT_TIMEOUT_SECONDS=10
MAX_MEDIA_SIZE_MB=16

GAS_URL_LAYANAN_DATA=https://script.google.com/macros/s/xxx/exec
GAS_URL_INDIKATOR=https://script.google.com/macros/s/xxx/exec
GAS_URL_VIDEO=https://script.google.com/macros/s/xxx/exec
GAS_URL_INFOGRAFIK=https://script.google.com/macros/s/xxx/exec
GAS_URL_PAKAR=https://script.google.com/macros/s/xxx/exec
GAS_URL_FAQ=https://script.google.com/macros/s/xxx/exec

# ==========================================
# 6. TAUTAN MEDIA EKSTERNAL
# ==========================================
TENTANG_BPS_VIDEO_URL=https://www.youtube.com/watch?v=BFj6yi8HLAg

# ==========================================
# 7. WEBAPI BPS (https://webapi.bps.go.id)
# ==========================================
BPS_API_BASE_URL=https://webapi.bps.go.id/v1/api/list
BPS_API_KEY=
BPS_DEFAULT_DOMAIN=1903
BPS_DEFAULT_LANG=ind
BPS_CACHE_TTL_MINUTES=15

# ==========================================
# 8. KONFIGURASI SCRAPER BPS BANGKA BARAT
# ==========================================
SCRAPER_ENABLED=true
SCRAPER_BASE_URL=https://bangkabaratkab.bps.go.id
SCRAPER_ALLOWED_HOSTS=bangkabaratkab.bps.go.id
SCRAPER_USER_AGENT=BotIstimewa/3.1 (+https://bangkabaratkab.bps.go.id; kontak: bps1903@bps.go.id)
SCRAPER_DB_PATH=./storage/scraper.db
SCRAPER_SELECTORS_PATH=./configs/scraper_selectors.yaml

# Jadwal
SCRAPER_CRON_SPEC=0 */6 * * *
SCRAPER_TIMEZONE=Asia/Jakarta
SCRAPER_RUN_TIMEOUT_MINUTES=10
SCRAPER_STARTUP_CATCHUP_HOURS=6
SCRAPER_MANUAL_COOLDOWN_MINUTES=5

# Kind yang diaktifkan (urut prioritas)
SCRAPER_ENABLED_KINDS=pressrelease,publication,infographic,statictable

# Kesopanan & batas
SCRAPER_MIN_DELAY_MS=3000
SCRAPER_JITTER_MS=1000
SCRAPER_HTTP_TIMEOUT_SECONDS=20
SCRAPER_MAX_PAGE_BYTES=3145728
SCRAPER_MAX_LIST_PAGES=5
SCRAPER_MAX_REQUESTS_PER_RUN=60
SCRAPER_RESPECT_ROBOTS=true

# Kesegaran & prioritas sumber data
SCRAPER_MAX_STALE_HOURS=48
DATA_SOURCE_ORDER=bpsapi,scraper,gsheet

# Notifikasi admin (nomor harus ada di ADMIN_WHITELIST_NUMBERS)
SCRAPER_NOTIFY_ADMIN=true
SCRAPER_NOTIFY_AFTER_FAILURES=2

# ==========================================
# 8. NOTIFIKASI GRUP INTERNAL KANTOR (PST)
# ==========================================
# Isi dengan Group JID WhatsApp grup kantor PST (misal: 120363xxxxxx@g.us)
# Jika diisi, setiap permohonan jadwal konsultasi baru akan otomatis diteruskan ke grup ini.
INTERNAL_PST_GROUP_JID=
