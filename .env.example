# ==============================================================================
# TEMPLATE KONFIGURASI ENVIRONMENT — BOT ISTIMEWA v3.4 (.env.example)
# Salin file ini menjadi .env lalu isi nilai konfigurasinya sesuai kebutuhan:
#   cp .env.example .env
# ==============================================================================

# ==========================================
# 1. KONFIGURASI SERVER & GO FIBER
# ==========================================
APP_ENV=
APP_HOST=
APP_PORT=
API_SECRET_KEY=

# ==========================================
# 2. IDENTITAS & SESI WHATSAPP
# ==========================================
WA_BROWSER_NAME=
WA_DB_PATH=
ALLOWED_NUMBERS=

# ==========================================
# 3. KEAMANAN ADMIN CHAT
# ==========================================
ADMIN_TRIGGER_KEYWORD=
ADMIN_PASSWORD=
ADMIN_WHITELIST_NUMBERS=
ADMIN_MAX_RETRY=
ADMIN_LOCKOUT_MINUTES=
DEVELOPER_PHONE=

# ==========================================
# 4. RATE LIMITER, IDLE TIMER & QUEUE
# ==========================================
USER_RATE_LIMIT_PER_10S=
USER_COOLDOWN_SECONDS=
IDLE_TIMEOUT_MINUTES=
ACTIVE_INDICATOR_YEAR=
QUEUE_INTERACTIVE_MIN_DELAY_MS=
QUEUE_INTERACTIVE_MAX_DELAY_MS=
QUEUE_BLAST_MIN_DELAY_MS=
QUEUE_BLAST_MAX_DELAY_MS=
# Set false (default) agar menu dikirim sebagai teks bernomor universal (100% kompatibel di iPhone iOS & Android).
# Set true jika ingin mencoba tombol native flow khusus perangkat tertentu.
ENABLE_INTERACTIVE_MENUS=false

# ==========================================
# 5. ENDPOINT GOOGLE APPS SCRIPT (LEGACY)
# ==========================================
GAS_CACHE_TTL_MINUTES=
HTTP_CLIENT_TIMEOUT_SECONDS=
MAX_MEDIA_SIZE_MB=
GAS_URL_LAYANAN_DATA=
GAS_URL_INDIKATOR=
GAS_URL_VIDEO=
GAS_URL_INFOGRAFIK=
GAS_URL_PAKAR=
GAS_URL_FAQ=

# ==========================================
# 6. TAUTAN MEDIA EKSTERNAL
# ==========================================
TENTANG_BPS_VIDEO_URL=

# ==========================================
# 7. WEBAPI BPS (https://webapi.bps.go.id)
# ==========================================
BPS_API_BASE_URL=
BPS_API_KEY=
BPS_DEFAULT_DOMAIN=
BPS_DEFAULT_LANG=
BPS_CACHE_TTL_MINUTES=

# ==========================================
# 8. KONFIGURASI SCRAPER BPS BANGKA BARAT
# ==========================================
SCRAPER_ENABLED=
SCRAPER_BASE_URL=
SCRAPER_ALLOWED_HOSTS=
SCRAPER_USER_AGENT=
SCRAPER_DB_PATH=
SCRAPER_SELECTORS_PATH=
SCRAPER_CRON_SPEC=
SCRAPER_TIMEZONE=
SCRAPER_RUN_TIMEOUT_MINUTES=
SCRAPER_STARTUP_CATCHUP_HOURS=
SCRAPER_MANUAL_COOLDOWN_MINUTES=
SCRAPER_ENABLED_KINDS=
SCRAPER_MIN_DELAY_MS=
SCRAPER_JITTER_MS=
SCRAPER_HTTP_TIMEOUT_SECONDS=
SCRAPER_MAX_PAGE_BYTES=
SCRAPER_MAX_LIST_PAGES=
SCRAPER_MAX_REQUESTS_PER_RUN=
SCRAPER_RESPECT_ROBOTS=
SCRAPER_MAX_STALE_HOURS=
DATA_SOURCE_ORDER=
SCRAPER_NOTIFY_ADMIN=
SCRAPER_NOTIFY_AFTER_FAILURES=

# ==========================================
# 9. NOTIFIKASI GRUP INTERNAL KANTOR (PST)
# ==========================================
INTERNAL_PST_GROUP_JID=
