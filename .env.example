# ==============================================================================
# CONTOH KONFIGURASI ENVIRONMENT (TEMPLATE .env.example)
# Salin file ini menjadi .env dan sesuaikan nilainya dengan konfigurasi Anda:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Konfigurasi Server & Keamanan Dashboard API
# ------------------------------------------------------------------------------
# Port HTTP server untuk dashboard web & Webhook (/qr, /health, /api/*)
APP_PORT=3000

# Secret key untuk otentikasi REST API /api/blast dan /api/cache/refresh
# Kirim via header 'X-API-Key: <nilai_di_bawah>' atau 'Authorization: Bearer <nilai_di_bawah>'
API_SECRET_KEY=ganti_dengan_api_secret_key_anda_di_sini

# Kata kunci yang diketik user di WhatsApp untuk memicu login mode Admin
ADMIN_TRIGGER_KEYWORD="login admin - 1234"

# Password yang harus dimasukkan setelah memicu ADMIN_TRIGGER_KEYWORD
ADMIN_PASSWORD=ganti_dengan_password_admin_rahasia

# ------------------------------------------------------------------------------
# 2. Konfigurasi WhatsApp Client
# ------------------------------------------------------------------------------
# Nama browser WhatsApp Web yang tampil di menu 'Perangkat Tertaut' pada ponsel bot
WA_BROWSER_NAME="BPS KABUPATEN BANGKA BARAT"

# Batasi bot hanya merespons nomor tertentu (pisahkan koma, misal: 628123456789,628987654321)
# Kosongkan ("") agar bot dapat diakses oleh publik / semua orang
ALLOWED_NUMBERS=""

# Durasi toleransi sesi idle pengguna sebelum ditutup otomatis dan dikirim survei SKD (dalam menit)
IDLE_TIMEOUT_MINUTES=15

# Tahun data indikator strategis aktif yang ditampilkan (misal: 2024, 2025, 2026)
ACTIVE_INDICATOR_YEAR=2025

# ------------------------------------------------------------------------------
# 3. Google Apps Script (GAS) Webhook Endpoints
# Masukkan URL deployment Google Apps Script (Exec) untuk masing-masing sheet database
# Format: https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec
# ------------------------------------------------------------------------------
GAS_URL_LAYANAN_DATA=https://script.google.com/macros/s/MASUKKAN_ID_DEPLOYMENT_GAS_LAYANAN_DATA/exec
GAS_URL_INDIKATOR=https://script.google.com/macros/s/MASUKKAN_ID_DEPLOYMENT_GAS_INDIKATOR/exec
GAS_URL_VIDEO=https://script.google.com/macros/s/MASUKKAN_ID_DEPLOYMENT_GAS_VIDEO/exec
GAS_URL_INFOGRAFIK=https://script.google.com/macros/s/MASUKKAN_ID_DEPLOYMENT_GAS_INFOGRAFIK/exec
GAS_URL_PAKAR=https://script.google.com/macros/s/MASUKKAN_ID_DEPLOYMENT_GAS_PAKAR/exec
GAS_URL_FAQ=https://script.google.com/macros/s/MASUKKAN_ID_DEPLOYMENT_GAS_FAQ/exec

# Durasi in-memory cache data Google Sheets sebelum di-refresh otomatis (dalam menit)
GAS_CACHE_TTL_MINUTES=15

# ------------------------------------------------------------------------------
# 4. Tautan Media Eksternal
# ------------------------------------------------------------------------------
# URL video profil Tentang BPS (YouTube atau direct video link)
TENTANG_BPS_VIDEO_URL=https://www.youtube.com/watch?v=MASUKKAN_ID_VIDEO
